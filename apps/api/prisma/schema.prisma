generator client { provider = "prisma-client-js" }
datasource db { provider = "mysql" url = env("DATABASE_URL") }
enum Role { FAN CREATOR ADMIN }
enum DigitalOrderStatus { PENDING_PAYMENT PAID PROVISIONING ACTIVE CANCELLED REFUNDED }
model User { id String @id @default(cuid()) email String @unique passwordHash String? role Role @default(FAN) displayName String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt creatorProfile CreatorProfile? digitalOrders DigitalOrder[] pointWallet PointWallet? }
model CreatorProfile { id String @id @default(cuid()) userId String @unique slug String @unique bio String @default("") safeAddressMemo String? user User @relation(fields:[userId], references:[id]) digitalProducts DigitalProduct[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model DigitalProduct { id String @id @default(cuid()) creatorId String title String imageUrl String? description String? pointPrice Int priority Int @default(0) isActive Boolean @default(true) creator CreatorProfile @relation(fields:[creatorId], references:[id]) orders DigitalOrder[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PointWallet { id String @id @default(cuid()) userId String @unique balance Int @default(0) user User @relation(fields:[userId], references:[id]) charges PointCharge[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PointCharge { id String @id @default(cuid()) walletId String points Int amount Int paymentProvider String paymentKey String? status DigitalOrderStatus @default(PENDING_PAYMENT) wallet PointWallet @relation(fields:[walletId], references:[id]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model DigitalOrder { id String @id @default(cuid()) creatorId String productId String? fanId String? purchaserName String message String? pointAmount Int status DigitalOrderStatus @default(PENDING_PAYMENT) paymentProvider String paymentKey String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt fan User? @relation(fields:[fanId], references:[id]) product DigitalProduct? @relation(fields:[productId], references:[id]) }
model Report { id String @id @default(cuid()) targetType String targetId String reason String status String @default("OPEN") createdAt DateTime @default(now()) }
