RewriteEngine On

RewriteRule ^categories/?$ categories.php [L,QSA]
RewriteRule ^creators/?$ creators.php [L,QSA]
RewriteRule ^creators/([^/]+)/?$ creators.php?slug=$1 [L,QSA]
RewriteRule ^supports/?$ supports.php [L,QSA]

RewriteRule ^auth/signup/?$ auth/signup.php [L,QSA]
RewriteRule ^auth/login/?$ auth/login.php [L,QSA]
RewriteRule ^auth/logout/?$ auth/logout.php [L,QSA]

RewriteRule ^payments/orders/?$ payments/orders.php [L,QSA]
RewriteRule ^payments/confirm/?$ payments/confirm.php [L,QSA]

RewriteRule ^admin/summary/?$ admin/summary.php [L,QSA]
RewriteRule ^admin/users/?$ admin/users.php [L,QSA]
RewriteRule ^admin/creators/?$ admin/creators.php [L,QSA]
RewriteRule ^admin/payments/?$ admin/payments.php [L,QSA]
RewriteRule ^admin/settings/?$ admin/settings.php [L,QSA]
