{
  "name": "creator-safe-support-platform",
  "private": true,
  "version": "0.2.0",
  "description": "한국형 크리에이터 안심 선물/포인트 이용 플랫폼 MVP",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev -w apps/api\" \"npm:dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/api",
    "start": "npm run start -w apps/api",
    "test": "node scripts/smoke-test.mjs",
    "lint": "echo lint-ready",
    "format": "echo format-ready"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.13.0"
}
