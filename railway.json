{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w packages/shared && npm run build -w apps/web && npm run prisma:generate -w apps/api && npm run build -w apps/api"
  },
  "deploy": {
    "startCommand": "npm run start -w apps/api",
    "preDeployCommand": "npm run prisma:migrate -w apps/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
